# Copy this file to .env.local and fill in real values for your machine.
# .env holds only the dev-safe DATABASE_URL default and is committed;
# .env.local is gitignored and should hold your real secrets.

# --- Database ---
# Local dev default (SQLite via libSQL, zero setup): file:./dev.db
# Before going live for the exhibition, switch to a hosted database, e.g.
# Turso (hosted libSQL, same adapter/schema — no code change) or Postgres/Neon
# (requires swapping the driver adapter in src/lib/db.ts and the provider in
# prisma/schema.prisma — see PROJECT_NOTES.md "Going live").
DATABASE_URL="file:./dev.db"
# Only needed if DATABASE_URL points at a hosted libSQL/Turso database.
DATABASE_AUTH_TOKEN=""

# --- Admin login ---
# The single shared admin password used to access /admin. Pick something only
# you know — this protects your product entry and the preorder list.
ADMIN_PASSWORD="change-me"
# Random secret used to sign the admin login cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="change-me-too"

# --- Product image storage ---
# "local" saves uploaded photos to /public/uploads — fine for local dev, but
# does NOT persist on Vercel (serverless filesystem is ephemeral/read-only in
# production). Before deploying, set this to "vercel-blob" and add
# BLOB_READ_WRITE_TOKEN (from the Vercel Blob dashboard) — see
# PROJECT_NOTES.md "Going live".
STORAGE_DRIVER="local"
BLOB_READ_WRITE_TOKEN=""

# --- Email sending ---
# "console" (default) logs instead of sending — nothing goes out. Sprint 3's
# Notification Centre only renders/saves email HTML, it never calls
# emailService.send(). A real provider (e.g. "resend") gets wired up here in
# a future sprint, behind the same EmailService interface — see
# src/lib/email/types.ts. (This is what Milestone 1's brief called
# EMAIL_PROVIDER — kept as EMAIL_DRIVER to match the existing STORAGE_DRIVER
# naming convention rather than introducing a second name for the same idea.)
EMAIL_DRIVER="console"
# Reserved for whichever provider EMAIL_DRIVER eventually selects (e.g. a
# Resend API key) — unused by "console", not read anywhere yet.
EMAIL_API_KEY=""

# --- Base URL (optional) ---
# Every current use of the site's own URL (edit links, product/collection
# links, unsubscribe links — see src/lib/email/site-url.ts) derives it from
# the incoming request's Host header, which auto-adapts across
# localhost/staging/production with zero config and is preferred over a
# static value. BASE_URL is reserved for a future context that has no
# request to read a Host header from — e.g. a Sprint 4 scheduled/cron email
# send — and isn't read by any code yet.
BASE_URL=""

# --- Staging access gate (Milestone 1) ---
# When BOTH are set, every route (not just /admin) requires this HTTP Basic
# Auth login before anything else runs — see src/proxy.ts. Leave both blank
# for local dev and for a future real production deploy; set them only on
# the staging deployment's environment variables in Vercel. See
# docs/DEPLOYMENT.md "Staging Mode".
STAGING_BASIC_AUTH_USER=""
STAGING_BASIC_AUTH_PASSWORD=""
